# Groq API Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it)
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model (HuggingFace / SentenceTransformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths
DATABASE_PATH=database/onboarding.db
CHROMA_DIR=database/chroma_db
DATA_DIR=data
